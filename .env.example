# Shared defaults (used by both APIs unless overridden below)
CATAPA_TENANT=your-tenant
CATAPA_BASE_URL=https://api.catapa.com

# --- OAuth login (recommended for the private API) --------------------------
# Set to "oauth" to authenticate BOTH the public and private clients via a single interactive
# browser login (CATAPA's real OAuth2 authorization-code flow), instead of the per-API credentials
# below. catapa-private has no OAuth of its own, but its client accepts a static bearer token, so
# the token obtained this way authenticates it too. The browser opens automatically the first time
# the server starts (or whenever the cached token can't be refreshed); no further action is needed
# on later launches. Requires CATAPA_CLIENT_ID/CATAPA_CLIENT_SECRET below (tenant is discovered
# from the login callback, so CATAPA_TENANT is optional in this mode).
# CATAPA_MCP_AUTH_MODE=oauth

# Override CATAPA's OAuth authorization endpoint (optional).
# CATAPA_AUTHORIZATION_URL=https://accounts.catapa.com/oauth2/authorize

# Where the logged-in token is cached between server launches (optional).
# CATAPA_MCP_TOKEN_CACHE=~/.catapa-mcp/oauth-token.json

# --- Public API (catapa) -----------------------------------------------------
# Either set an access token directly...
CATAPA_ACCESS_TOKEN=
# ...or OAuth2 client credentials.
CATAPA_CLIENT_ID=
CATAPA_CLIENT_SECRET=

# Overrides tenant/base URL for the public API only (optional).
# CATAPA_PUBLIC_TENANT=
# CATAPA_PUBLIC_BASE_URL=

# Set to false to skip registering the ~300 public API tools.
# CATAPA_MCP_ENABLE_PUBLIC=true

# Comma-separated resource namespace prefixes to include/exclude, e.g.:
# CATAPA_MCP_INCLUDE=core.employees,timemanagement
# CATAPA_MCP_EXCLUDE=anomalydetection

# --- Private API (catapa-private) --------------------------------------------
# Either set an access token directly...
CATAPA_PRIVATE_ACCESS_TOKEN=
# ...or a username/password (session-based auth).
CATAPA_PRIVATE_USERNAME=
CATAPA_PRIVATE_PASSWORD=

# Overrides tenant/base URL for the private API only (optional).
# CATAPA_PRIVATE_TENANT=
# CATAPA_PRIVATE_BASE_URL=

# Set to false to skip registering the 7 private API tools.
# CATAPA_MCP_ENABLE_PRIVATE=true

# --- Remote deployment (src/catapa_mcp/remote/, e.g. on Vercel) --------------
# Only used by the multi-tenant, private-API-only Streamable HTTP server -- not the stdio server
# above. Each connecting user logs in to CATAPA with their own account via OAuth; see the "Remote
# deployment" section in README.md.

# This deployment's own public HTTPS URL (required).
# MCP_SERVER_URL=https://your-app.vercel.app

# Encrypts every connected user's CATAPA credentials into their MCP token (required). Generate:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Treat this like a master credential -- whoever holds it can decrypt every connected user's
# CATAPA access. Don't rotate it casually: rotating logs everyone out.
# MCP_TOKEN_ENCRYPTION_KEY=

# Set automatically once an Upstash Redis store is attached via the Vercel Marketplace -- you
# normally don't set these by hand.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Which TokenStore backend to use for OAuth client registrations + login-flow state (optional;
# "redis" is the only one implemented so far -- see src/catapa_mcp/remote/store.py).
# CATAPA_MCP_STORE_BACKEND=redis

# CATAPA_CLIENT_ID/CATAPA_CLIENT_SECRET (above) are reused for the remote server's OAuth broker.
# CATAPA_BASE_URL/CATAPA_AUTHORIZATION_URL/CATAPA_PRIVATE_BASE_URL (above) are reused too.
